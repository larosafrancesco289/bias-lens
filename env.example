# OpenRouter API key for bias analysis
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model/provider selection. Defaults to DeepSeek V4 Flash on the DeepSeek provider.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_PROVIDER=deepseek

# Optional: Site URL and Name for OpenRouter rankings (good practice)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=BiasLens
