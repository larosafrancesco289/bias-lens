# OpenRouter API key for bias analysis
OPENROUTER_API_KEY=your_openrouter_api_key_here

# DeepSeek model selection. Non-deepseek values are ignored.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional: Site URL and Name for OpenRouter rankings (good practice)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=BiasLens
